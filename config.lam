from lamerrors import Result, Error
from lamos import Os
from @lam/ssh import SshKeyPair

go! {
    import "golang.org/x/crypto/ssh"

    // lamSftpUnsupported returns the first name not in ``supported`` (or "").
    func lamSftpUnsupported(names []string, supported []string) string {
        known := make(map[string]bool, len(supported))
        for _, name := range supported {
            known[name] = true
        }
        for _, name := range names {
            if !known[name] {
                return name
            }
        }
        return ""
    }
}

class SftpConfig {
    func init(self, hostKey: str = "", address: str = "127.0.0.1:2022", startDirectory: str = "/", maxReadBytes: int = 67108864, maxWriteBytes: int = 67108864, maxPacketBytes: int = 32768, maxConnections: int = 256, handshakeTimeoutMs: int = 10000, idleTimeoutMs: int = 300000, maxAuthTries: int = 6, authAttemptsPerSecond: int = 20, authBurst: int = 40) {
        self.hostKey: str = hostKey
        self.hostKeys: list[str] = []
        #- Host keys announced to clients (OpenSSH ``hostkeys-00`` /
           UpdateHostKeys) without being offered in the handshake: the next
           keys of a rotation. -#
        self.announcedHostKeys: list[str] = []
        #- Accept OpenSSH user certificates (verified: CA signature, validity,
           the username among the principals, ``source-address``); the
           public-key callback decides whether the CA is trusted. -#
        self.userCertificates: bool = false
        if hostKey != "" {
            self.hostKeys.append(hostKey)
        }
        self.hostKeyPassphrase: str = ""
        self.address: str = address
        self.startDirectory: str = startDirectory
        self.maxReadBytes: int = maxReadBytes
        self.maxWriteBytes: int = maxWriteBytes
        self.maxPacketBytes: int = maxPacketBytes
        self.maxConnections: int = maxConnections
        self.handshakeTimeoutMs: int = handshakeTimeoutMs
        self.idleTimeoutMs: int = idleTimeoutMs
        self.maxAuthTries: int = maxAuthTries
        self.authAttemptsPerSecond: int = authAttemptsPerSecond
        self.authBurst: int = authBurst
        # Per client address (IP): attempts per minute and burst (0 = off),
        # and a lockout after ``addressMaxFailures`` failures within
        # ``addressLockoutSeconds`` (0 = off).
        self.addressAttemptsPerMinute: int = 0
        self.addressBurst: int = 0
        self.addressMaxFailures: int = 0
        self.addressLockoutSeconds: int = 0
        self.serverVersion: str = "SSH-2.0-lam-sftp"
        # PROXY protocol (v1/v2) from trusted load balancers: "off",
        # "optional" or "required" (see ``withProxyProtocol``).
        self.proxyProtocol: str = "off"
        self.proxyTrusted: list[str] = []
        self.production: bool = false
        self.reuseBuffers: bool = true
        # SSH algorithms offered to clients; empty means the SSH library's
        # secure defaults. Clients choose their first supported entry.
        self.ciphers: list[str] = []
        # Adaptive ciphers: ``ciphers`` is offered only to clients whose SSH
        # version line shows support for them (``gcmCapable``); everyone else
        # gets ``fallbackCiphers`` (empty = the SSH library's defaults).
        self.adaptiveCiphers: bool = false
        self.fallbackCiphers: list[str] = []
        self.keyExchanges: list[str] = []
        self.macs: list[str] = []
    }

    static func fastCiphers() -> list[str] {
        #- AES-GCM only (hardware-accelerated AEAD). OpenSSH prefers
           ChaCha20-Poly1305, then AES-CTR with a separate MAC; offering only
           AES-GCM makes it negotiate the fastest option on CPUs with AES-NI
           (about 1.6x OpenSSH's default). Not supported by libssh2 before
           1.11 (curl on Debian 12, PHP ssh2): use ``withAdaptiveCiphers`` to
           offer it only to clients that support it. -#
        return ["aes128-gcm@openssh.com", "aes256-gcm@openssh.com"]
    }

    static func fromKeyFile(path: str, address: str = "127.0.0.1:2022", startDirectory: str = "/", maxReadBytes: int = 67108864, maxWriteBytes: int = 67108864, maxPacketBytes: int = 32768) -> Result[SftpConfig] {
        hostKey: str = Os.readFile(path)?
        return Result.Ok(SftpConfig(hostKey, address, startDirectory, maxReadBytes, maxWriteBytes, maxPacketBytes))
    }

    func validate(self) -> Result[bool] {
        if len(self.hostKeys) == 0 {
            return Result.Err(Error("SftpConfigError", "at least one host key is required", None))
        }
        if self.address == "" {
            return Result.Err(Error("SftpConfigError", "address is required", None))
        }
        if self.startDirectory == "" or not self.startDirectory.startsWith("/") {
            return Result.Err(Error("SftpConfigError", "startDirectory must be an absolute POSIX path", None))
        }
        if self.maxReadBytes < 0 {
            return Result.Err(Error("SftpConfigError", "maxReadBytes cannot be negative", None))
        }
        if self.maxWriteBytes < 0 {
            return Result.Err(Error("SftpConfigError", "maxWriteBytes cannot be negative", None))
        }
        if self.maxPacketBytes < 32768 or self.maxPacketBytes > 16777216 {
            return Result.Err(Error("SftpConfigError", "maxPacketBytes must be between 32768 and 16777216", None))
        }
        if self.maxConnections < 1 {
            return Result.Err(Error("SftpConfigError", "maxConnections must be at least 1", None))
        }
        if self.handshakeTimeoutMs < 1 or self.idleTimeoutMs < 0 {
            return Result.Err(Error("SftpConfigError", "handshakeTimeoutMs must be positive and idleTimeoutMs cannot be negative", None))
        }
        if self.maxAuthTries < 1 {
            return Result.Err(Error("SftpConfigError", "maxAuthTries must be at least 1", None))
        }
        if self.authAttemptsPerSecond < 0 or self.authBurst < 1 {
            return Result.Err(Error("SftpConfigError", "authAttemptsPerSecond cannot be negative and authBurst must be positive", None))
        }
        if self.addressAttemptsPerMinute < 0 or self.addressBurst < 0 or self.addressMaxFailures < 0 or self.addressLockoutSeconds < 0 {
            return Result.Err(Error("SftpConfigError", "per-address authentication limits cannot be negative", None))
        }
        if (self.addressMaxFailures > 0) != (self.addressLockoutSeconds > 0) {
            return Result.Err(Error("SftpConfigError", "withAddressLockout needs both maxFailures and lockoutSeconds", None))
        }
        if self.proxyProtocol != "off" and self.proxyProtocol != "optional" and self.proxyProtocol != "required" {
            return Result.Err(Error("SftpConfigError", "proxy protocol mode must be off, optional or required", None))
        }
        if self.proxyProtocol != "off" and len(self.proxyTrusted) == 0 {
            return Result.Err(Error("SftpConfigError", "withProxyProtocol needs at least one trusted CIDR", None))
        }
        trusted: list[str] = self.proxyTrusted
        badTrusted: str = go!(lamSftpBadCidr(trusted))
        if badTrusted != "" {
            return Result.Err(Error("SftpConfigError", f"invalid trusted proxy address \"{badTrusted}\"", None))
        }
        if not self.serverVersion.startsWith("SSH-2.0-") {
            return Result.Err(Error("SftpConfigError", "serverVersion must start with SSH-2.0-", None))
        }
        ciphers: list[str] = self.ciphers
        keyExchanges: list[str] = self.keyExchanges
        macs: list[str] = self.macs
        fallbackCiphers: list[str] = self.fallbackCiphers
        badFallback: str = go!(lamSftpUnsupported(fallbackCiphers, ssh.SupportedAlgorithms().Ciphers))
        if badFallback != "" {
            return Result.Err(Error("SftpConfigError", f"unsupported SSH cipher \"{badFallback}\"", None))
        }
        badCipher: str = go!(lamSftpUnsupported(ciphers, ssh.SupportedAlgorithms().Ciphers))
        if badCipher != "" {
            return Result.Err(Error("SftpConfigError", f"unsupported SSH cipher \"{badCipher}\"", None))
        }
        badKex: str = go!(lamSftpUnsupported(keyExchanges, ssh.SupportedAlgorithms().KeyExchanges))
        if badKex != "" {
            return Result.Err(Error("SftpConfigError", f"unsupported SSH key exchange \"{badKex}\"", None))
        }
        badMac: str = go!(lamSftpUnsupported(macs, ssh.SupportedAlgorithms().MACs))
        if badMac != "" {
            return Result.Err(Error("SftpConfigError", f"unsupported SSH MAC \"{badMac}\"", None))
        }
        return Result.Ok(true)
    }

    func withAddress(self, address: str) -> SftpConfig {
        self.address = address
        return self
    }

    func withStartDirectory(self, path: str) -> SftpConfig {
        self.startDirectory = path
        return self
    }

    func withReadLimit(self, maxBytes: int) -> SftpConfig {
        self.maxReadBytes = maxBytes
        return self
    }

    func withWriteLimit(self, maxBytes: int) -> SftpConfig {
        self.maxWriteBytes = maxBytes
        return self
    }

    func withPacketSize(self, maxBytes: int) -> SftpConfig {
        self.maxPacketBytes = maxBytes
        return self
    }

    func addHostKey(self, key: str) -> SftpConfig {
        if key != "" {
            self.hostKeys.append(key)
            if self.hostKey == "" {
                self.hostKey = key
            }
        }
        return self
    }

    #- Announces ``key`` (after authentication, ``hostkeys-00@openssh.com``)
       without offering it in the handshake, so clients that support
       UpdateHostKeys learn it before it becomes a served key. -#
    func announceHostKey(self, key: str) -> SftpConfig {
        if key != "" {
            self.announcedHostKeys.append(key)
        }
        return self
    }

    func announceHostKeyFile(self, path: str) -> Result[SftpConfig] {
        key: str = Os.readFile(path)?
        return Result.Ok(self.announceHostKey(key))
    }

    func withUserCertificates(self, enabled: bool = true) -> SftpConfig {
        self.userCertificates = enabled
        return self
    }

    func addHostKeyFile(self, path: str) -> Result[SftpConfig] {
        key: str = Os.readFile(path)?
        return Result.Ok(self.addHostKey(key))
    }

    func withHostKeyPassphrase(self, passphrase: str) -> SftpConfig {
        self.hostKeyPassphrase = passphrase
        return self
    }

    func withConnectionLimit(self, maxConnections: int) -> SftpConfig {
        self.maxConnections = maxConnections
        return self
    }

    func withTimeouts(self, handshakeMs: int, idleMs: int) -> SftpConfig {
        self.handshakeTimeoutMs = handshakeMs
        self.idleTimeoutMs = idleMs
        return self
    }

    func withAuthRateLimit(self, attemptsPerSecond: int, burst: int) -> SftpConfig {
        self.authAttemptsPerSecond = attemptsPerSecond
        self.authBurst = burst
        return self
    }

    #- Limits authentication attempts per client IP (``attemptsPerMinute``
       steady rate, ``burst`` at once), checked before the server-wide
       ``withAuthRateLimit`` budget so one address cannot use it up for
       everybody. 0 disables it. -#
    func withAddressAuthRateLimit(self, attemptsPerMinute: int, burst: int) -> SftpConfig {
        self.addressAttemptsPerMinute = attemptsPerMinute
        self.addressBurst = burst
        return self
    }

    #- Refuses every authentication attempt from a client IP for
       ``lockoutSeconds`` after ``maxFailures`` failed attempts within
       ``lockoutSeconds``; a successful sign-in resets the count. 0 disables
       it. -#
    func withAddressLockout(self, maxFailures: int, lockoutSeconds: int) -> SftpConfig {
        self.addressMaxFailures = maxFailures
        self.addressLockoutSeconds = lockoutSeconds
        return self
    }

    #- Accepts a PROXY protocol header (HAProxy v1 text or v2 binary) from
       load balancers whose address is in ``trustedCidrs`` (CIDRs or single
       IPs), so sessions, authentication callbacks, limits and logs see the
       real client address. ``mode``: ``"off"`` (default), ``"optional"``
       (trusted peers may send a header; connections without one keep the
       TCP peer) or ``"required"`` (only trusted peers that send a header
       are served; everything else is closed before the SSH handshake). A
       header from an untrusted peer is never honoured. -#
    func withProxyProtocol(self, mode: str, trustedCidrs: list[str]) -> SftpConfig {
        self.proxyProtocol = mode
        self.proxyTrusted = trustedCidrs
        return self
    }

    func withCiphers(self, ciphers: list[str]) -> SftpConfig {
        #- Restrict the ciphers offered to every client (see ``fastCiphers``). -#
        self.ciphers = ciphers
        self.adaptiveCiphers = false
        return self
    }

    func withAdaptiveCiphers(self, ciphers: list[str], fallback: list[str] = []) -> SftpConfig {
        #- Offer ``ciphers`` (e.g. ``fastCiphers()``) to clients known to
           support them, judged by their SSH version line, and ``fallback``
           (empty = library defaults) to every other client, so older
           libraries (libssh2 < 1.11) still connect. A client that does not
           send its version line within a second gets the fallback. -#
        self.ciphers = ciphers
        self.fallbackCiphers = fallback
        self.adaptiveCiphers = true
        return self
    }

    static func gcmCapable(clientVersion: str) -> bool {
        #- True for SSH clients known to implement AES-GCM
           (``aes128-gcm@openssh.com``): OpenSSH 6.2+, libssh 0.9+, libssh2
           1.11+, Go's x/crypto (rclone, ...), paramiko 3.5+, PuTTY 0.76+. -#
        out: bool = false
        go! {
            out = lamSftpGcmCapable(clientVersion)
        }
        return out
    }

    func withKeyExchanges(self, keyExchanges: list[str]) -> SftpConfig {
        self.keyExchanges = keyExchanges
        return self
    }

    func withMacs(self, macs: list[str]) -> SftpConfig {
        self.macs = macs
        return self
    }

    func withBufferReuse(self, enabled: bool = true) -> SftpConfig {
        #- Reuse SFTP packet buffers across requests (default). Disable only if
           a byte callback must keep its ``data`` slice after returning. -#
        self.reuseBuffers = enabled
        return self
    }

    func withServerVersion(self, version: str) -> SftpConfig {
        self.serverVersion = version
        return self
    }

    func productionMode(self, enabled: bool = true) -> SftpConfig {
        self.production = enabled
        return self
    }
}

class SftpKey {
    static func generate() -> Result[str] {
        pair: SshKeyPair = SshKeyPair.generateHostEd25519("lam-sftp host key", "")?
        return Result.Ok(pair.privateKeyPem)
    }

    static func readFile(path: str) -> Result[str] {
        return Os.readFile(path)
    }

    #- ``SHA256:...`` fingerprint of the public half of ``privateKey`` (what
       clients show and compare). -#
    static func fingerprint(privateKey: str) -> Result[str] {
        out: str = ""
        failure: str = ""
        go! {
            fingerprint, _, err := lamSftpKeyInfo(privateKey)
            if err != nil {
                failure = err.Error()
            } else {
                out = fingerprint
            }
        }
        if failure != "" {
            return Result.Err(Error("SftpKeyError", f"parse host key: {failure}", None))
        }
        return Result.Ok(out)
    }

    #- The public half of ``privateKey`` as an authorized_keys / known_hosts
       line (``ssh-ed25519 AAAA...``). -#
    static func publicKey(privateKey: str) -> Result[str] {
        out: str = ""
        failure: str = ""
        go! {
            _, authorized, err := lamSftpKeyInfo(privateKey)
            if err != nil {
                failure = err.Error()
            } else {
                out = authorized
            }
        }
        if failure != "" {
            return Result.Err(Error("SftpKeyError", f"parse host key: {failure}", None))
        }
        return Result.Ok(out)
    }
}

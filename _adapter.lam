    // ── host key rotation: OpenSSH hostkeys-00 / hostkeys-prove-00 ──────

    // lamSftpAnnounceHostKeys tells the client every host key of the server
    // (served and announced), so OpenSSH clients with UpdateHostKeys add the
    // ones they do not know to known_hosts after proving them.
    func lamSftpAnnounceHostKeys(conn *ssh.ServerConn, signers []ssh.Signer) {
        if len(signers) == 0 {
            return
        }
        var payload []byte
        for _, signer := range signers {
            payload = append(payload, ssh.Marshal(struct{ Key []byte }{signer.PublicKey().Marshal()})...)
        }
        _, _, _ = conn.SendRequest("hostkeys-00@openssh.com", false, payload)
    }

    // lamSftpGlobalRequests answers hostkeys-prove-00@openssh.com: for each
    // requested key a signature over the session identifier made with that
    // key; anything else is refused.
    func lamSftpGlobalRequests(conn *ssh.ServerConn, requests <-chan *ssh.Request, signers []ssh.Signer) {
        for request := range requests {
            if request.Type != "hostkeys-prove-00@openssh.com" {
                if request.WantReply {
                    _ = request.Reply(false, nil)
                }
                continue
            }
            ok := true
            var reply []byte
            rest := request.Payload
            for len(rest) > 0 && ok {
                var item struct {
                    Key  []byte
                    Rest []byte `ssh:"rest"`
                }
                if err := ssh.Unmarshal(rest, &item); err != nil {
                    ok = false
                    break
                }
                rest = item.Rest
                var signer ssh.Signer
                for _, candidate := range signers {
                    if bytes.Equal(candidate.PublicKey().Marshal(), item.Key) {
                        signer = candidate
                        break
                    }
                }
                if signer == nil {
                    ok = false
                    break
                }
                data := ssh.Marshal(struct {
                    Name      string
                    SessionID []byte
                    Key       []byte
                }{"hostkeys-prove-00@openssh.com", conn.SessionID(), item.Key})
                var signature *ssh.Signature
                var err error
                if algorithmSigner, isAlgorithm := signer.(ssh.AlgorithmSigner); isAlgorithm && signer.PublicKey().Type() == ssh.KeyAlgoRSA {
                    signature, err = algorithmSigner.SignWithAlgorithm(cryptorand.Reader, data, ssh.KeyAlgoRSASHA512)
                } else {
                    signature, err = signer.Sign(cryptorand.Reader, data)
                }
                if err != nil {
                    ok = false
                    break
                }
                reply = append(reply, ssh.Marshal(struct{ Signature []byte }{ssh.Marshal(signature)})...)
            }
            if request.WantReply {
                if ok {
                    _ = request.Reply(true, reply)
                } else {
                    _ = request.Reply(false, nil)
                }
            }
        }
    }

    // lamSftpKeyInfo: SHA256 fingerprint and authorized_keys line of the
    // public half of a private key.
    func lamSftpKeyInfo(privateKey string) (string, string, error) {
        signer, err := ssh.ParsePrivateKey([]byte(privateKey))
        if err != nil {
            return "", "", err
        }
        public := signer.PublicKey()
        return ssh.FingerprintSHA256(public), strings.TrimSpace(string(ssh.MarshalAuthorizedKey(public))), nil
    }

    // ── user certificates ───────────────────────────────────────────────

    // lamSftpCheckCertificate verifies an OpenSSH user certificate (CA
    // signature, validity, principals, source-address) and fills auth.
    func lamSftpCheckCertificate(meta ssh.ConnMetadata, cert *ssh.Certificate, auth *SftpAuth) error {
        checker := &ssh.CertChecker{
            IsUserAuthority:          func(ssh.PublicKey) bool { return true },
            SupportedCriticalOptions: []string{"source-address"},
        }
        if _, err := checker.Authenticate(meta, cert); err != nil {
            return err
        }
        // CertChecker leaves source-address to the server's handshake, which
        // only sees options returned in Permissions: check it here.
        if allowed, ok := cert.CriticalOptions["source-address"]; ok {
            host, _, err := net.SplitHostPort(meta.RemoteAddr().String())
            if err != nil {
                return err
            }
            ip := net.ParseIP(host)
            matched := false
            for _, item := range strings.Split(allowed, ",") {
                item = strings.TrimSpace(item)
                if _, network, err := net.ParseCIDR(item); err == nil {
                    matched = matched || (ip != nil && network.Contains(ip))
                } else if single := net.ParseIP(item); single != nil {
                    matched = matched || single.Equal(ip)
                } else {
                    return fmt.Errorf("certificate source-address: invalid entry %q", item)
                }
            }
            if !matched {
                return fmt.Errorf("certificate source-address does not allow %s", host)
            }
        }
        auth.Certificate = true
        auth.CertKeyId = cert.KeyId
        auth.CertSerial = int(cert.Serial)
        auth.CertPrincipals = append([]string(nil), cert.ValidPrincipals...)
        auth.CertAuthority = strings.TrimSpace(string(ssh.MarshalAuthorizedKey(cert.SignatureKey)))
        auth.CertAuthorityFingerprint = ssh.FingerprintSHA256(cert.SignatureKey)
        auth.CertValidAfter = int(cert.ValidAfter)
        if cert.ValidBefore != ssh.CertTimeInfinity && cert.ValidBefore < 1<<62 {
            auth.CertValidBefore = int(cert.ValidBefore)
        }
        auth.PublicKey = strings.TrimSpace(string(ssh.MarshalAuthorizedKey(cert.Key)))
        auth.Fingerprint = ssh.FingerprintSHA256(cert.Key)
        return nil
    }

    // ── fsync@openssh.com ───────────────────────────────────────────────

    // lamSftpFsyncShim sits between the SSH channel and pkg/sftp (which has
    // no server-side fsync): it advertises fsync@openssh.com in the version
    // packet, tracks which path each handle opened and which writes are
    // still outstanding, and answers fsync requests itself once the writes
    // received before them have been answered.
    type lamSftpFsyncShim struct {
        channel     io.ReadWriteCloser
        backend     *lamSftpBackend
        writeMu     sync.Mutex
        mu          sync.Mutex
        drained     *sync.Cond
        incoming    []byte
        deliver     []byte
        outgoing    []byte
        opens       map[uint32]string
        closes      map[uint32]string
        handles     map[string]string
        pending     map[string]map[uint32]bool
        writeHandle map[uint32]string
    }

    func lamSftpNewFsyncShim(channel io.ReadWriteCloser, backend *lamSftpBackend) *lamSftpFsyncShim {
        shim := &lamSftpFsyncShim{
            channel:     channel,
            backend:     backend,
            opens:       map[uint32]string{},
            closes:      map[uint32]string{},
            handles:     map[string]string{},
            pending:     map[string]map[uint32]bool{},
            writeHandle: map[uint32]string{},
        }
        shim.drained = sync.NewCond(&shim.mu)
        return shim
    }

    func lamSftpWireString(b []byte) (string, []byte, bool) {
        if len(b) < 4 {
            return "", nil, false
        }
        n := binary.BigEndian.Uint32(b)
        if uint64(len(b)-4) < uint64(n) {
            return "", nil, false
        }
        return string(b[4 : 4+n]), b[4+n:], true
    }

    func (s *lamSftpFsyncShim) Read(p []byte) (int, error) {
        for len(s.deliver) == 0 {
            buf := make([]byte, 32768)
            n, err := s.channel.Read(buf)
            if n > 0 {
                s.incoming = append(s.incoming, buf[:n]...)
                s.parseIncoming()
            }
            if err != nil && len(s.deliver) == 0 {
                return 0, err
            }
        }
        n := copy(p, s.deliver)
        s.deliver = s.deliver[n:]
        return n, nil
    }

    func (s *lamSftpFsyncShim) parseIncoming() {
        for len(s.incoming) >= 5 {
            length := binary.BigEndian.Uint32(s.incoming)
            if uint64(len(s.incoming)-4) < uint64(length) {
                return
            }
            packet := s.incoming[:4+length]
            s.incoming = s.incoming[4+length:]
            body := packet[4:]
            kind := body[0]
            forward := true
            if len(body) >= 5 {
                id := binary.BigEndian.Uint32(body[1:5])
                rest := body[5:]
                s.mu.Lock()
                switch kind {
                case 3: // SSH_FXP_OPEN
                    if name, _, ok := lamSftpWireString(rest); ok {
                        s.opens[id] = name
                    }
                case 4: // SSH_FXP_CLOSE
                    if handle, _, ok := lamSftpWireString(rest); ok {
                        s.closes[id] = handle
                    }
                case 6: // SSH_FXP_WRITE
                    if handle, _, ok := lamSftpWireString(rest); ok {
                        if s.pending[handle] == nil {
                            s.pending[handle] = map[uint32]bool{}
                        }
                        s.pending[handle][id] = true
                        s.writeHandle[id] = handle
                    }
                case 200: // SSH_FXP_EXTENDED
                    if name, after, ok := lamSftpWireString(rest); ok && name == "fsync@openssh.com" {
                        if handle, _, ok := lamSftpWireString(after); ok {
                            forward = false
                            go s.fsync(id, handle)
                        }
                    }
                }
                s.mu.Unlock()
            }
            if forward {
                s.deliver = append(s.deliver, packet...)
            }
        }
    }

    func (s *lamSftpFsyncShim) Write(p []byte) (int, error) {
        s.writeMu.Lock()
        defer s.writeMu.Unlock()
        s.outgoing = append(s.outgoing, p...)
        for len(s.outgoing) >= 5 {
            length := binary.BigEndian.Uint32(s.outgoing)
            if uint64(len(s.outgoing)-4) < uint64(length) {
                break
            }
            packet := append([]byte(nil), s.outgoing[:4+length]...)
            s.outgoing = s.outgoing[4+length:]
            body := packet[4:]
            switch body[0] {
            case 2: // SSH_FXP_VERSION: advertise fsync@openssh.com
                ext := append(ssh.Marshal(struct{ Name string }{"fsync@openssh.com"}), ssh.Marshal(struct{ Version string }{"1"})...)
                body = append(body, ext...)
                packet = make([]byte, 4, 4+len(body))
                binary.BigEndian.PutUint32(packet, uint32(len(body)))
                packet = append(packet, body...)
            case 102: // SSH_FXP_HANDLE
                if len(body) >= 5 {
                    id := binary.BigEndian.Uint32(body[1:5])
                    if handle, _, ok := lamSftpWireString(body[5:]); ok {
                        s.mu.Lock()
                        if name, known := s.opens[id]; known {
                            s.handles[handle] = name
                            delete(s.opens, id)
                        }
                        s.mu.Unlock()
                    }
                }
            case 101: // SSH_FXP_STATUS
                if len(body) >= 5 {
                    id := binary.BigEndian.Uint32(body[1:5])
                    s.mu.Lock()
                    delete(s.opens, id)
                    if handle, known := s.writeHandle[id]; known {
                        delete(s.pending[handle], id)
                        delete(s.writeHandle, id)
                        s.drained.Broadcast()
                    }
                    if handle, known := s.closes[id]; known {
                        delete(s.handles, handle)
                        delete(s.pending, handle)
                        delete(s.closes, id)
                    }
                    s.mu.Unlock()
                }
            }
            if _, err := s.channel.Write(packet); err != nil {
                return 0, err
            }
        }
        return len(p), nil
    }

    func (s *lamSftpFsyncShim) status(id uint32, code uint32, message string) {
        body := []byte{101}
        body = binary.BigEndian.AppendUint32(body, id)
        body = binary.BigEndian.AppendUint32(body, code)
        body = append(body, ssh.Marshal(struct {
            Message string
            Lang    string
        }{message, ""})...)
        packet := binary.BigEndian.AppendUint32(nil, uint32(len(body)))
        packet = append(packet, body...)
        s.writeMu.Lock()
        _, _ = s.channel.Write(packet)
        s.writeMu.Unlock()
    }

    func (s *lamSftpFsyncShim) fsync(id uint32, handle string) {
        defer func() {
            if recovered := recover(); recovered != nil {
                s.status(id, 4, fmt.Sprintf("fsync failed: %v", recovered))
            }
        }()
        s.mu.Lock()
        for len(s.pending[handle]) > 0 {
            s.drained.Wait()
        }
        name, ok := s.handles[handle]
        s.mu.Unlock()
        if !ok {
            s.status(id, 4, "fsync: unknown handle")
            return
        }
        request := NewSftpRequest()
        request.Method = "Fsync"
        request.Path = path.Clean("/" + name)
        request.User = s.backend.user
        request.RemoteAddress = s.backend.remote
        request.Session = make(map[string]string, len(s.backend.session))
        for key, value := range s.backend.session {
            request.Session[key] = value
        }
        result := s.backend.handlers.DispatchFsync(request)
        if err := lamSftpResultError(result); err != nil {
            s.status(id, 4, err.Error())
            return
        }
        s.status(id, 0, "")
    }

    func (s *lamSftpFsyncShim) Close() error {
        return s.channel.Close()
    }

    var lamSftpExtensionsOnce sync.Once
    var lamSftpExtensionsError error

    func lamSftpConfigureExtensions() error {
        lamSftpExtensionsOnce.Do(func() {
            lamSftpExtensionsError = pkgsftp.SetSFTPExtensions(
                "hardlink@openssh.com",
                "posix-rename@openssh.com",
                "statvfs@openssh.com",
            )
        })
        return lamSftpExtensionsError
    }

    type lamSftpRuntime struct {
        mu             sync.Mutex
        listener       net.Listener
        conns          map[net.Conn]struct{}
        // Authenticated connections and their auth metadata.
        sessions       map[net.Conn]map[string]string
        closed         bool
        finished       chan struct{}
        sshConfig      *ssh.ServerConfig
        // Set for adaptive ciphers: offered to clients not known to
        // support sshConfig's ciphers.
        fallbackConfig *ssh.ServerConfig
        maxConnections int
        idleTimeout    time.Duration
        // Served and announced host keys (hostkeys-00 / hostkeys-prove-00).
        hostSigners    []ssh.Signer
        // Per-destination host keys (onHostKeysFor): the configuration
        // without keys, the callback, parsed keys by PEM text.
        template        ssh.ServerConfig
        keysFor         func(string) []string
        fallbackCiphers []string
        signerMu        sync.Mutex
        signerCache     map[string]ssh.Signer
        parseKey        func(string) (ssh.Signer, error)
        wg             sync.WaitGroup
    }

    func (rt *lamSftpRuntime) add(conn net.Conn) bool {
        rt.mu.Lock()
        defer rt.mu.Unlock()
        if rt.closed || (rt.maxConnections > 0 && len(rt.conns) >= rt.maxConnections) {
            return false
        }
        rt.conns[conn] = struct{}{}
        rt.wg.Add(1)
        return true
    }

    func (rt *lamSftpRuntime) remove(conn net.Conn) {
        rt.mu.Lock()
        delete(rt.conns, conn)
        delete(rt.sessions, conn)
        rt.mu.Unlock()
        rt.wg.Done()
    }

    func (rt *lamSftpRuntime) track(conn net.Conn, connection *ssh.ServerConn) {
        info := map[string]string{}
        if connection.Permissions != nil {
            for key, value := range connection.Permissions.Extensions {
                info[key] = value
            }
        }
        info["username"] = connection.User()
        info["remoteAddress"] = connection.RemoteAddr().String()
        info["connectedAt"] = strconv.FormatInt(time.Now().Unix(), 10)
        rt.mu.Lock()
        if rt.sessions == nil {
            rt.sessions = make(map[net.Conn]map[string]string)
        }
        rt.sessions[conn] = info
        rt.mu.Unlock()
    }

    func (rt *lamSftpRuntime) snapshot() []map[string]string {
        rt.mu.Lock()
        defer rt.mu.Unlock()
        out := make([]map[string]string, 0, len(rt.sessions))
        for _, info := range rt.sessions {
            copied := make(map[string]string, len(info))
            for key, value := range info {
                copied[key] = value
            }
            out = append(out, copied)
        }
        return out
    }

    // disconnect closes the authenticated connections whose metadata has
    // key == value and returns how many there were.
    func (rt *lamSftpRuntime) disconnect(key, value string) int {
        rt.mu.Lock()
        var matched []net.Conn
        for conn, info := range rt.sessions {
            if got, ok := info[key]; ok && got == value {
                matched = append(matched, conn)
            }
        }
        rt.mu.Unlock()
        for _, conn := range matched {
            _ = conn.Close()
        }
        return len(matched)
    }

    func (rt *lamSftpRuntime) stop() {
        rt.mu.Lock()
        if rt.closed {
            rt.mu.Unlock()
            return
        }
        rt.closed = true
        listener := rt.listener
        conns := make([]net.Conn, 0, len(rt.conns))
        for conn := range rt.conns {
            conns = append(conns, conn)
        }
        rt.mu.Unlock()
        if listener != nil {
            _ = listener.Close()
        }
        for _, conn := range conns {
            _ = conn.Close()
        }
    }

    func (rt *lamSftpRuntime) isClosed() bool {
        rt.mu.Lock()
        defer rt.mu.Unlock()
        return rt.closed
    }

    // lamSftpDeadlineConn enforces the idle timeout. Arming a socket deadline
    // on every Read/Write costs a timer update per SSH packet, so a deadline is
    // only re-armed once its remaining time drops below ``timeout - slack``
    // (slack = min(timeout/10, 1s)): an idle connection still closes between
    // ``timeout - slack`` and ``timeout`` after its last activity.
    type lamSftpDeadlineConn struct {
        net.Conn
        timeout    atomic.Int64
        readUntil  atomic.Int64
        writeUntil atomic.Int64
    }

    func (conn *lamSftpDeadlineConn) currentTimeout() time.Duration {
        return time.Duration(conn.timeout.Load())
    }

    func (conn *lamSftpDeadlineConn) setTimeout(timeout time.Duration) {
        conn.timeout.Store(int64(timeout))
        conn.readUntil.Store(0)
        conn.writeUntil.Store(0)
        _ = conn.Conn.SetDeadline(time.Time{})
    }

    func (conn *lamSftpDeadlineConn) arm(until *atomic.Int64, set func(time.Time) error) {
        timeout := conn.currentTimeout()
        if timeout <= 0 {
            return
        }
        slack := timeout / 10
        if slack > time.Second {
            slack = time.Second
        }
        now := time.Now()
        if until.Load()-now.UnixNano() > int64(timeout-slack) {
            return
        }
        deadline := now.Add(timeout)
        until.Store(deadline.UnixNano())
        _ = set(deadline)
    }

    func (conn *lamSftpDeadlineConn) Read(data []byte) (int, error) {
        conn.arm(&conn.readUntil, conn.Conn.SetReadDeadline)
        return conn.Conn.Read(data)
    }

    func (conn *lamSftpDeadlineConn) Write(data []byte) (int, error) {
        conn.arm(&conn.writeUntil, conn.Conn.SetWriteDeadline)
        return conn.Conn.Write(data)
    }

    type lamSftpFileInfo struct {
        file *SftpFile
    }

    func (info lamSftpFileInfo) Name() string {
        if info.file.Name != "" {
            return info.file.Name
        }
        name := path.Base(info.file.Path)
        if name == "." || name == "/" {
            return info.file.Path
        }
        return name
    }

    func (info lamSftpFileInfo) Size() int64 {
        return int64(info.file.Size)
    }

    func (info lamSftpFileInfo) Mode() os.FileMode {
        mode := os.FileMode(info.file.Permissions)
        switch strings.ToLower(info.file.Kind) {
        case "directory", "dir":
            mode |= os.ModeDir
        case "symlink", "link":
            mode |= os.ModeSymlink
        }
        return mode
    }

    func (info lamSftpFileInfo) ModTime() time.Time {
        return time.Unix(int64(info.file.ModifiedUnix), 0)
    }

    func (info lamSftpFileInfo) IsDir() bool {
        kind := strings.ToLower(info.file.Kind)
        return kind == "directory" || kind == "dir"
    }

    func (info lamSftpFileInfo) Sys() interface{} {
        return nil
    }

    func (info lamSftpFileInfo) Uid() uint32 {
        return uint32(info.file.Uid)
    }

    func (info lamSftpFileInfo) Gid() uint32 {
        return uint32(info.file.Gid)
    }

    func (info lamSftpFileInfo) Extended() []pkgsftp.StatExtended {
        values := make([]pkgsftp.StatExtended, 0, len(info.file.Extended))
        for _, item := range info.file.Extended {
            if item != nil {
                values = append(values, pkgsftp.StatExtended{ExtType: item.Name, ExtData: item.Data})
            }
        }
        return values
    }

    type lamSftpLister []os.FileInfo

    func (items lamSftpLister) ListAt(target []os.FileInfo, offset int64) (int, error) {
        if offset >= int64(len(items)) {
            return 0, io.EOF
        }
        count := copy(target, items[offset:])
        if count < len(target) {
            return count, io.EOF
        }
        return count, nil
    }

    type lamSftpWriteBuffer struct {
        mu          sync.Mutex
        backend     *lamSftpBackend
        request     *SftpRequest
        data        []byte
        maxBytes    int
        closed      bool
        dirty       bool
        transferErr error
    }

    func (writer *lamSftpWriteBuffer) ReadAt(target []byte, offset int64) (int, error) {
        writer.mu.Lock()
        defer writer.mu.Unlock()
        return bytes.NewReader(writer.data).ReadAt(target, offset)
    }

    func (writer *lamSftpWriteBuffer) WriteAt(data []byte, offset int64) (int, error) {
        writer.mu.Lock()
        defer writer.mu.Unlock()
        if writer.closed {
            return 0, os.ErrClosed
        }
        if offset < 0 {
            writer.transferErr = os.ErrInvalid
            return 0, writer.transferErr
        }
        end := offset + int64(len(data))
        if end < offset || end > int64(^uint(0)>>1) {
            writer.transferErr = os.ErrInvalid
            return 0, writer.transferErr
        }
        if writer.maxBytes > 0 && end > int64(writer.maxBytes) {
            writer.transferErr = fmt.Errorf("write exceeds maxWriteBytes (%d)", writer.maxBytes)
            return 0, writer.transferErr
        }
        if int(end) > len(writer.data) {
            writer.data = append(writer.data, make([]byte, int(end)-len(writer.data))...)
        }
        copy(writer.data[int(offset):int(end)], data)
        writer.dirty = true
        return len(data), nil
    }

    func (writer *lamSftpWriteBuffer) TransferError(err error) {
        writer.mu.Lock()
        writer.transferErr = err
        writer.mu.Unlock()
    }

    func (writer *lamSftpWriteBuffer) Close() error {
        writer.mu.Lock()
        if writer.closed {
            writer.mu.Unlock()
            return nil
        }
        writer.closed = true
        transferErr := writer.transferErr
        dirty := writer.dirty
        data := append([]byte(nil), writer.data...)
        writer.mu.Unlock()
        if transferErr != nil {
            return transferErr
        }
        if !dirty {
            return nil
        }
        result := writer.backend.write(writer.request, data)
        return lamSftpResultError(result)
    }

    type lamSftpStreamingHandle struct {
        mu          sync.Mutex
        backend     *lamSftpBackend
        request     *SftpRequest
        readable    bool
        writable    bool
        closed      bool
        transferErr error
    }

    func (handle *lamSftpStreamingHandle) ReadAt(target []byte, offset int64) (count int, err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                count = 0
                err = fmt.Errorf("stream read callback panicked: %v", recovered)
            }
        }()
        if !handle.readable || offset < 0 {
            return 0, os.ErrInvalid
        }
        var data []byte
        if handle.backend.handlers.HasReadAtBytes {
            result := handle.backend.handlers.DispatchReadAtBytes(handle.request, int(offset), len(target))
            if err := lamSftpResultError(result); err != nil {
                return 0, err
            }
            raw, ok := result.Value.([]byte)
            if !ok && result.Value != nil {
                return 0, errors.New("readAtBytes callback must return Result[bytes]")
            }
            if len(raw) > len(target) {
                return 0, fmt.Errorf("readAtBytes returned %d bytes for a %d-byte request", len(raw), len(target))
            }
            data = raw
        } else {
            result := handle.backend.handlers.DispatchReadAt(handle.request, int(offset), len(target))
            converted, err := lamSftpBytes(result, len(target))
            if err != nil {
                return 0, err
            }
            data = converted
        }
        count = copy(target, data)
        handle.backend.handlers.Metrics.BytesRead.Add(count)
        if count < len(target) {
            return count, io.EOF
        }
        return count, nil
    }

    func (handle *lamSftpStreamingHandle) WriteAt(data []byte, offset int64) (count int, err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                count = 0
                err = fmt.Errorf("stream write callback panicked: %v", recovered)
            }
        }()
        if !handle.writable || offset < 0 {
            return 0, os.ErrInvalid
        }
        var result *Result
        if handle.backend.handlers.HasWriteAtBytes {
            result = handle.backend.handlers.DispatchWriteAtBytes(handle.request, data, int(offset))
        } else {
            values := make([]int, len(data))
            for index, value := range data {
                values[index] = int(value)
            }
            result = handle.backend.handlers.DispatchWriteAt(handle.request, values, int(offset))
        }
        if err := lamSftpResultError(result); err != nil {
            handle.TransferError(err)
            return 0, err
        }
        count, ok := result.Value.(int)
        if !ok || count < 0 || count > len(data) {
            err = errors.New("writeAt callback must return Result[int] within the input length")
            handle.TransferError(err)
            return 0, err
        }
        if count != len(data) {
            err = fmt.Errorf("writeAt callback wrote %d of %d bytes", count, len(data))
            handle.TransferError(err)
            return 0, err
        }
        handle.backend.handlers.Metrics.BytesWritten.Add(count)
        return count, nil
    }

    func (handle *lamSftpStreamingHandle) TransferError(err error) {
        handle.mu.Lock()
        handle.transferErr = err
        handle.mu.Unlock()
        func() {
            defer func() { _ = recover() }()
            handle.backend.handlers.TransferErrorCallback(handle.request, err)
        }()
    }

    func (handle *lamSftpStreamingHandle) Close() (err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                err = fmt.Errorf("stream close callback panicked: %v", recovered)
            }
        }()
        handle.mu.Lock()
        if handle.closed {
            handle.mu.Unlock()
            return nil
        }
        handle.closed = true
        transferErr := handle.transferErr
        handle.mu.Unlock()
        if handle.readable {
            if closeErr := lamSftpResultError(handle.backend.handlers.DispatchCloseRead(handle.request)); closeErr != nil && err == nil {
                err = closeErr
            }
        }
        if handle.writable && transferErr == nil {
            if closeErr := lamSftpResultError(handle.backend.handlers.DispatchCloseWrite(handle.request)); closeErr != nil && err == nil {
                err = closeErr
            }
        }
        if transferErr != nil {
            return transferErr
        }
        return err
    }

    type lamSftpBackend struct {
        handlers *SftpHandlers
        user     string
        remote   string
        session  map[string]string
        startDir string
        maxRead  int
        maxWrite int
    }

    func lamSftpFailure(kind string, message string) *Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(kind, message, nil))
    }

    func lamSftpResultError(result *Result) error {
        if result == nil {
            return errors.New("SFTP callback returned no Result")
        }
        if result.Ok() {
            return nil
        }
        message := fmt.Sprint(result.Error)
        kind := ""
        if structured, ok := result.Error.(*Error); ok && structured != nil {
            kind = strings.ToLower(structured.Kind)
            message = structured.Message
        }
        switch kind {
        case "notfound", "nosuchfile", "sftpnotfound":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxNoSuchFile, message)
        case "permissiondenied", "forbidden", "sftppermissiondenied":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxPermissionDenied, message)
        case "alreadyexists", "exists", "sftpalreadyexists":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxFailure, message)
        case "invalid", "invalidrequest", "sftpinvalid":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxBadMessage, message)
        case "unsupported", "sftpunsupported":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxOpUnsupported, message)
        case "eof", "sftpeof":
            return io.EOF
        case "noconnection", "sftpnoconnection":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxNoConnection, message)
        case "connectionlost", "sftpconnectionlost":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxConnectionLost, message)
        case "failure", "sftpfailure":
            return fmt.Errorf("%w: %s", pkgsftp.ErrSSHFxFailure, message)
        }
        return errors.New(message)
    }

    func lamSftpRequest(raw *pkgsftp.Request, backend *lamSftpBackend) *SftpRequest {
        request := NewSftpRequest()
        request.Method = raw.Method
        request.Path = raw.Filepath
        request.Target = raw.Target
        request.User = backend.user
        request.RemoteAddress = backend.remote
        request._context = raw.Context()
        request.Session = make(map[string]string, len(backend.session))
        for key, value := range backend.session {
            request.Session[key] = value
        }
        flags := raw.Pflags()
        request.Read = flags.Read
        request.Write = flags.Write
        request.Append = flags.Append
        request.Create = flags.Creat
        request.Truncate = flags.Trunc
        request.Exclusive = flags.Excl
        if raw.Method == "Setstat" {
            attrs := raw.AttrFlags()
            request.HasSize = attrs.Size
            request.HasUidGid = attrs.UidGid
            request.HasPermissions = attrs.Permissions
            request.HasModifiedTime = attrs.Acmodtime
            request.HasAccessTime = attrs.Acmodtime
            if attrs.Size || attrs.UidGid || attrs.Permissions || attrs.Acmodtime || len(raw.Attrs) > 0 {
                values := raw.Attributes()
                if values != nil {
                    request.Size = int(values.Size)
                    request.Uid = int(values.UID)
                    request.Gid = int(values.GID)
                    request.Permissions = int(values.Mode)
                    request.ModifiedUnix = int(values.Mtime)
                    request.AccessedUnix = int(values.Atime)
                    request.HasExtended = len(values.Extended) > 0
                    request.Extended = make([]*SftpExtended, 0, len(values.Extended))
                    for _, item := range values.Extended {
                        request.Extended = append(request.Extended, NewSftpExtended(item.ExtType, item.ExtData))
                    }
                }
            }
        }
        return request
    }

    func (backend *lamSftpBackend) read(request *SftpRequest) (result *Result) {
        defer func() {
            if recovered := recover(); recovered != nil {
                result = lamSftpFailure("SftpCallbackError", fmt.Sprintf("read callback panicked: %v", recovered))
            }
        }()
        return backend.handlers.DispatchRead(request)
    }

    func (backend *lamSftpBackend) write(request *SftpRequest, data []byte) (result *Result) {
        defer func() {
            if recovered := recover(); recovered != nil {
                result = lamSftpFailure("SftpCallbackError", fmt.Sprintf("write callback panicked: %v", recovered))
            }
        }()
        values := make([]int, len(data))
        for index, value := range data {
            values[index] = int(value)
        }
        result = backend.handlers.DispatchWrite(request, values)
        if result != nil && result.Ok() {
            backend.handlers.Metrics.BytesWritten.Add(len(data))
        }
        return result
    }

    func (backend *lamSftpBackend) list(request *SftpRequest) (result *Result) {
        defer func() {
            if recovered := recover(); recovered != nil {
                result = lamSftpFailure("SftpCallbackError", fmt.Sprintf("list callback panicked: %v", recovered))
            }
        }()
        return backend.handlers.DispatchList(request)
    }

    func (backend *lamSftpBackend) command(request *SftpRequest) (result *Result) {
        defer func() {
            if recovered := recover(); recovered != nil {
                result = lamSftpFailure("SftpCallbackError", fmt.Sprintf("command callback panicked: %v", recovered))
            }
        }()
        return backend.handlers.DispatchCommand(request)
    }

    func lamSftpBytes(result *Result, maxBytes int) ([]byte, error) {
        if err := lamSftpResultError(result); err != nil {
            return nil, err
        }
        var values []int
        switch raw := result.Value.(type) {
        case []int:
            values = raw
        case []interface{}:
            values = make([]int, len(raw))
            for index, item := range raw {
                value, ok := item.(int)
                if !ok {
                    return nil, errors.New("read callback list contains a non-int value")
                }
                values[index] = value
            }
        default:
            return nil, errors.New("read callback must return Result[list[int]]")
        }
        if maxBytes > 0 && len(values) > maxBytes {
            return nil, fmt.Errorf("read exceeds maxReadBytes (%d)", maxBytes)
        }
        data := make([]byte, len(values))
        for index, value := range values {
            if value < 0 || value > 255 {
                return nil, fmt.Errorf("read callback byte at index %d is outside 0..255", index)
            }
            data[index] = byte(value)
        }
        return data, nil
    }

    func lamSftpString(result *Result) (string, error) {
        if err := lamSftpResultError(result); err != nil {
            return "", err
        }
        value, ok := result.Value.(string)
        if !ok {
            return "", errors.New("callback must return Result[str]")
        }
        return value, nil
    }

    func (backend *lamSftpBackend) Fileread(raw *pkgsftp.Request) (io.ReaderAt, error) {
        request := lamSftpRequest(raw, backend)
        if backend.handlers.HasReadAt || backend.handlers.HasReadAtBytes {
            return &lamSftpStreamingHandle{backend: backend, request: request, readable: true}, nil
        }
        result := backend.read(request)
        data, err := lamSftpBytes(result, backend.maxRead)
        if err != nil {
            return nil, err
        }
        backend.handlers.Metrics.BytesRead.Add(len(data))
        return bytes.NewReader(data), nil
    }

    func (backend *lamSftpBackend) openWrite(request *SftpRequest) (err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                err = lamSftpResultError(lamSftpFailure("SftpCallbackError", fmt.Sprintf("openWrite callback panicked: %v", recovered)))
            }
        }()
        return lamSftpResultError(backend.handlers.DispatchOpenWrite(request))
    }

    func (backend *lamSftpBackend) Filewrite(raw *pkgsftp.Request) (io.WriterAt, error) {
        request := lamSftpRequest(raw, backend)
        if err := backend.openWrite(request); err != nil {
            return nil, err
        }
        if backend.handlers.HasWriteAt || backend.handlers.HasWriteAtBytes {
            return &lamSftpStreamingHandle{backend: backend, request: request, writable: true}, nil
        }
        return &lamSftpWriteBuffer{
            backend:  backend,
            request:  request,
            maxBytes: backend.maxWrite,
            dirty:    true,
        }, nil
    }

    func (backend *lamSftpBackend) OpenFile(raw *pkgsftp.Request) (pkgsftp.WriterAtReaderAt, error) {
        request := lamSftpRequest(raw, backend)
        canReadAt := backend.handlers.HasReadAt || backend.handlers.HasReadAtBytes
        canWriteAt := backend.handlers.HasWriteAt || backend.handlers.HasWriteAtBytes
        if flags := raw.Pflags(); flags.Write || flags.Creat || flags.Trunc || flags.Append {
            if err := backend.openWrite(request); err != nil {
                return nil, err
            }
        }
        if canReadAt && canWriteAt {
            return &lamSftpStreamingHandle{backend: backend, request: request, readable: true, writable: true}, nil
        }
        if canReadAt != canWriteAt {
            return nil, fmt.Errorf("%w: read-write Open requires both readAt and writeAt callbacks", pkgsftp.ErrSSHFxOpUnsupported)
        }
        var data []byte
        created := false
        flags := raw.Pflags()
        if !flags.Trunc {
            loaded, err := lamSftpBytes(backend.read(request), backend.maxRead)
            if err != nil {
                notFound := errors.Is(err, pkgsftp.ErrSSHFxNoSuchFile) || errors.Is(err, os.ErrNotExist)
                if !(flags.Creat && notFound) {
                    return nil, err
                }
                created = true
            } else {
                data = loaded
            }
        }
        if backend.maxWrite > 0 && len(data) > backend.maxWrite {
            return nil, fmt.Errorf("existing file exceeds maxWriteBytes (%d)", backend.maxWrite)
        }
        return &lamSftpWriteBuffer{
            backend:  backend,
            request:  request,
            data:     data,
            maxBytes: backend.maxWrite,
            dirty:    flags.Trunc || created,
        }, nil
    }

    func (backend *lamSftpBackend) Filecmd(raw *pkgsftp.Request) error {
        request := lamSftpRequest(raw, backend)
        return lamSftpResultError(backend.command(request))
    }

    func (backend *lamSftpBackend) PosixRename(raw *pkgsftp.Request) error {
        request := lamSftpRequest(raw, backend)
        request.Method = "PosixRename"
        return lamSftpResultError(backend.command(request))
    }

    func (backend *lamSftpBackend) StatVFS(raw *pkgsftp.Request) (stat *pkgsftp.StatVFS, err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                stat = nil
                err = fmt.Errorf("StatVFS callback panicked: %v", recovered)
            }
        }()
        request := lamSftpRequest(raw, backend)
        request.Method = "StatVFS"
        result := backend.handlers.DispatchStatVFS(request)
        if err := lamSftpResultError(result); err != nil {
            return nil, err
        }
        value, ok := result.Value.(*SftpStatVFS)
        if !ok || value == nil {
            return nil, errors.New("StatVFS callback must return Result[SftpStatVFS]")
        }
        if err := lamSftpResultError(value.Validate()); err != nil {
            return nil, err
        }
        return &pkgsftp.StatVFS{
            Bsize: uint64(value.BlockSize), Frsize: uint64(value.FragmentSize),
            Blocks: uint64(value.Blocks), Bfree: uint64(value.BlocksFree), Bavail: uint64(value.BlocksAvailable),
            Files: uint64(value.Files), Ffree: uint64(value.FilesFree), Favail: uint64(value.FilesAvailable),
            Fsid: uint64(value.FilesystemId), Flag: uint64(value.Flags), Namemax: uint64(value.NameMax),
        }, nil
    }

    func lamSftpFiles(result *Result) ([]*SftpFile, error) {
        if err := lamSftpResultError(result); err != nil {
            return nil, err
        }
        switch raw := result.Value.(type) {
        case []*SftpFile:
            return raw, nil
        case []interface{}:
            files := make([]*SftpFile, len(raw))
            for index, item := range raw {
                file, ok := item.(*SftpFile)
                if !ok || file == nil {
                    return nil, errors.New("list callback contains a non-SftpFile value")
                }
                files[index] = file
            }
            return files, nil
        default:
            return nil, errors.New("list callback must return Result[list[SftpFile]]")
        }
    }

    func (backend *lamSftpBackend) Filelist(raw *pkgsftp.Request) (pkgsftp.ListerAt, error) {
        request := lamSftpRequest(raw, backend)
        result := backend.list(request)
        files, err := lamSftpFiles(result)
        if err != nil {
            return nil, err
        }
        items := make(lamSftpLister, 0, len(files))
        for _, file := range files {
            if file == nil {
                return nil, errors.New("list callback returned an empty SftpFile")
            }
            if err := lamSftpResultError(file.Validate()); err != nil {
                return nil, err
            }
            items = append(items, lamSftpFileInfo{file: file})
        }
        return items, nil
    }

    func (backend *lamSftpBackend) Lstat(raw *pkgsftp.Request) (pkgsftp.ListerAt, error) {
        return backend.Filelist(raw)
    }

    func (backend *lamSftpBackend) RealPath(target string) (value string, err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                value = ""
                err = fmt.Errorf("RealPath callback panicked: %v", recovered)
            }
        }()
        if !backend.handlers.HasRealPath {
            if path.IsAbs(target) {
                return path.Clean(target), nil
            }
            return path.Clean(path.Join(backend.startDir, target)), nil
        }
        raw := pkgsftp.NewRequest("RealPath", target)
        request := lamSftpRequest(raw, backend)
        value, err = lamSftpString(backend.handlers.DispatchRealPath(request))
        if err != nil {
            return "", err
        }
        if !path.IsAbs(value) {
            return "", errors.New("RealPath callback must return an absolute POSIX path")
        }
        return path.Clean(value), nil
    }

    func (backend *lamSftpBackend) Readlink(target string) (value string, err error) {
        defer func() {
            if recovered := recover(); recovered != nil {
                value = ""
                err = fmt.Errorf("Readlink callback panicked: %v", recovered)
            }
        }()
        raw := pkgsftp.NewRequest("Readlink", target)
        request := lamSftpRequest(raw, backend)
        if backend.handlers.HasReadlink {
            return lamSftpString(backend.handlers.DispatchReadlink(request))
        }
        result := backend.list(request)
        files, err := lamSftpFiles(result)
        if err != nil {
            return "", err
        }
        if len(files) == 0 || files[0] == nil || files[0].Target == "" {
            return "", errors.New("Readlink must return a SftpFile with target set")
        }
        return files[0].Target, nil
    }

    func (backend *lamSftpBackend) LookupUserName(uid string) (name string) {
        defer func() { _ = recover() }()
        return backend.handlers.UsernameCallback(uid)
    }

    func (backend *lamSftpBackend) LookupGroupName(gid string) (name string) {
        defer func() { _ = recover() }()
        return backend.handlers.GroupCallback(gid)
    }

    func lamSftpPermissions(auth *SftpAuth) *ssh.Permissions {
        extensions := make(map[string]string, len(auth.Meta))
        for key, value := range auth.Meta {
            extensions[key] = value
        }
        return &ssh.Permissions{Extensions: extensions}
    }

    func lamSftpAuthCall(server *SftpServer, auth *SftpAuth, callback interface{}) (accepted bool) {
        defer func() {
            if recover() != nil {
                accepted = false
                server.Metrics.AuthFailed.Increment()
            }
        }()
        if !server.AllowAuthFrom(auth.RemoteAddress) {
            server.Metrics.AuthFailed.Increment()
            return false
        }
        handler, ok := callback.(func(*SftpAuth) bool)
        accepted = ok && handler(auth)
        server.RecordAuthOutcome(auth.RemoteAddress, accepted)
        if accepted {
            server.Metrics.AuthSucceeded.Increment()
        } else {
            server.Metrics.AuthFailed.Increment()
        }
        return accepted
    }

    func lamSftpServeChannels(connection *ssh.ServerConn, channels <-chan ssh.NewChannel, server *SftpServer) {
        for channelRequest := range channels {
            if channelRequest.ChannelType() != "session" {
                _ = channelRequest.Reject(ssh.UnknownChannelType, "session channel required")
                continue
            }
            channel, requests, err := channelRequest.Accept()
            if err != nil {
                continue
            }
            go func() {
                defer func() { _ = recover() }()
                defer channel.Close()
                for request := range requests {
                    accepted := false
                    if request.Type == "subsystem" {
                        var payload struct{ Name string }
                        if ssh.Unmarshal(request.Payload, &payload) == nil && payload.Name == "sftp" {
                            accepted = true
                        }
                    }
                    if request.WantReply {
                        _ = request.Reply(accepted, nil)
                    }
                    if !accepted {
                        continue
                    }
                    session := map[string]string{}
                    if connection.Permissions != nil {
                        for key, value := range connection.Permissions.Extensions {
                            session[key] = value
                        }
                    }
                    backend := &lamSftpBackend{
                        handlers: server.Handlers,
                        user:     connection.User(),
                        remote:   connection.RemoteAddr().String(),
                        session:  session,
                        startDir: server.Config.StartDirectory,
                        maxRead:  server.Config.MaxReadBytes,
                        maxWrite: server.Config.MaxWriteBytes,
                    }
                    options := []pkgsftp.RequestServerOption{
                        pkgsftp.WithStartDirectory(server.Config.StartDirectory),
                        pkgsftp.WithRSMaxTxPacket(uint32(server.Config.MaxPacketBytes)),
                    }
                    if server.Config.ReuseBuffers {
                        // Reuse packet buffers across requests instead of
                        // allocating one per packet; byte callbacks must not
                        // retain their ``data`` slice (documented contract).
                        options = append(options, pkgsftp.WithRSAllocator())
                    }
                    var stream io.ReadWriteCloser = channel
                    if server.Handlers.HasFsync {
                        stream = lamSftpNewFsyncShim(channel, backend)
                    }
                    requestServer := pkgsftp.NewRequestServer(
                        stream,
                        pkgsftp.Handlers{
                            FileGet:  backend,
                            FilePut:  backend,
                            FileCmd:  backend,
                            FileList: backend,
                        },
                        options...,
                    )
                    _ = requestServer.Serve()
                    return
                }
            }()
        }
    }

    // ── PROXY protocol (HAProxy v1/v2) ───────────────────────────────

    var lamSftpProxyV2Signature = []byte{0x0D, 0x0A, 0x0D, 0x0A, 0x00, 0x0D, 0x0A, 0x51, 0x55, 0x49, 0x54, 0x0A}

    func lamSftpParseCidrs(entries []string) ([]*net.IPNet, string) {
        var out []*net.IPNet
        for _, entry := range entries {
            entry = strings.TrimSpace(entry)
            if entry == "" {
                continue
            }
            if !strings.Contains(entry, "/") {
                ip := net.ParseIP(entry)
                if ip == nil {
                    return nil, entry
                }
                bits := 32
                if ip.To4() == nil {
                    bits = 128
                }
                entry = fmt.Sprintf("%s/%d", ip.String(), bits)
            }
            _, network, err := net.ParseCIDR(entry)
            if err != nil {
                return nil, entry
            }
            out = append(out, network)
        }
        return out, ""
    }

    func lamSftpBadCidr(entries []string) string {
        _, bad := lamSftpParseCidrs(entries)
        return bad
    }

    func lamSftpPeerTrusted(addr net.Addr, trusted []*net.IPNet) bool {
        host, _, err := net.SplitHostPort(addr.String())
        if err != nil {
            host = addr.String()
        }
        ip := net.ParseIP(host)
        if ip == nil {
            return false
        }
        for _, network := range trusted {
            if network.Contains(ip) {
                return true
            }
        }
        return false
    }

    // lamSftpProxyConn reports the client and destination addresses from
    // the PROXY header and replays the bytes read past it.
    type lamSftpProxyConn struct {
        net.Conn
        remote net.Addr
        local  net.Addr
        prefix []byte
    }

    func (c *lamSftpProxyConn) LocalAddr() net.Addr {
        if c.local != nil {
            return c.local
        }
        return c.Conn.LocalAddr()
    }

    // signersFor returns the host keys a callback chose for a destination
    // (nil: the configured ones). Unparsable keys are skipped.
    func (r *lamSftpRuntime) signersFor(local string) []ssh.Signer {
        if r.keysFor == nil {
            return nil
        }
        var keys []string
        func() {
            defer func() { _ = recover() }()
            keys = r.keysFor(local)
        }()
        var out []ssh.Signer
        for _, text := range keys {
            r.signerMu.Lock()
            signer, ok := r.signerCache[text]
            r.signerMu.Unlock()
            if !ok {
                parsed, err := r.parseKey(text)
                if err != nil {
                    continue
                }
                signer = parsed
                r.signerMu.Lock()
                if len(r.signerCache) > 4096 {
                    r.signerCache = make(map[string]ssh.Signer)
                }
                r.signerCache[text] = signer
                r.signerMu.Unlock()
            }
            out = append(out, signer)
        }
        return out
    }

    func (c *lamSftpProxyConn) Read(p []byte) (int, error) {
        if len(c.prefix) > 0 {
            n := copy(p, c.prefix)
            c.prefix = c.prefix[n:]
            return n, nil
        }
        return c.Conn.Read(p)
    }

    func (c *lamSftpProxyConn) RemoteAddr() net.Addr {
        if c.remote != nil {
            return c.remote
        }
        return c.Conn.RemoteAddr()
    }

    // lamSftpReadProxyHeader reads a PROXY v1 or v2 header from conn. It
    // returns the client and destination addresses (nil for v2 LOCAL / v1
    // UNKNOWN: keep the peer), the bytes read after the header, whether a
    // header was present, and an error for a malformed header.
    func lamSftpReadProxyHeader(conn net.Conn) (net.Addr, net.Addr, []byte, bool, error) {
        reader := bufio.NewReaderSize(conn, 536)
        first, err := reader.Peek(5)
        if err != nil {
            rest, _ := reader.Peek(reader.Buffered())
            return nil, nil, append([]byte(nil), rest...), false, nil
        }
        leftover := func() []byte {
            rest, _ := reader.Peek(reader.Buffered())
            return append([]byte(nil), rest...)
        }
        if string(first) == "PROXY" {
            line, err := reader.ReadSlice('\n')
            if err != nil || len(line) > 107 || !strings.HasSuffix(string(line), "\r\n") {
                return nil, nil, nil, true, fmt.Errorf("malformed PROXY v1 header")
            }
            fields := strings.Fields(strings.TrimSpace(string(line)))
            if len(fields) >= 2 && fields[1] == "UNKNOWN" {
                return nil, nil, leftover(), true, nil
            }
            if len(fields) != 6 || (fields[1] != "TCP4" && fields[1] != "TCP6") {
                return nil, nil, nil, true, fmt.Errorf("malformed PROXY v1 header")
            }
            ip := net.ParseIP(fields[2])
            port, perr := strconv.Atoi(fields[4])
            dip := net.ParseIP(fields[3])
            dport, derr := strconv.Atoi(fields[5])
            if ip == nil || perr != nil || port < 0 || port > 65535 || dip == nil || derr != nil || dport < 0 || dport > 65535 {
                return nil, nil, nil, true, fmt.Errorf("malformed PROXY v1 address")
            }
            return &net.TCPAddr{IP: ip, Port: port}, &net.TCPAddr{IP: dip, Port: dport}, leftover(), true, nil
        }
        if bytes.Equal(first, lamSftpProxyV2Signature[:5]) {
            head, err := reader.Peek(16)
            if err != nil || !bytes.Equal(head[:12], lamSftpProxyV2Signature) {
                return nil, nil, nil, true, fmt.Errorf("malformed PROXY v2 header")
            }
            version, command, family := head[12]>>4, head[12]&0x0F, head[13]
            length := int(binary.BigEndian.Uint16(head[14:16]))
            if version != 2 || length > 520 {
                return nil, nil, nil, true, fmt.Errorf("unsupported PROXY v2 header")
            }
            full := make([]byte, 16+length)
            if _, err := io.ReadFull(reader, full); err != nil {
                return nil, nil, nil, true, fmt.Errorf("truncated PROXY v2 header")
            }
            body := full[16:]
            if command == 0x0 {
                return nil, nil, leftover(), true, nil
            }
            if command != 0x1 {
                return nil, nil, nil, true, fmt.Errorf("unsupported PROXY v2 command")
            }
            switch family {
            case 0x11: // TCP over IPv4
                if len(body) < 12 {
                    return nil, nil, nil, true, fmt.Errorf("truncated PROXY v2 address")
                }
                return &net.TCPAddr{IP: net.IP(append([]byte(nil), body[0:4]...)), Port: int(binary.BigEndian.Uint16(body[8:10]))}, &net.TCPAddr{IP: net.IP(append([]byte(nil), body[4:8]...)), Port: int(binary.BigEndian.Uint16(body[10:12]))}, leftover(), true, nil
            case 0x21: // TCP over IPv6
                if len(body) < 36 {
                    return nil, nil, nil, true, fmt.Errorf("truncated PROXY v2 address")
                }
                return &net.TCPAddr{IP: net.IP(append([]byte(nil), body[0:16]...)), Port: int(binary.BigEndian.Uint16(body[32:34]))}, &net.TCPAddr{IP: net.IP(append([]byte(nil), body[16:32]...)), Port: int(binary.BigEndian.Uint16(body[34:36]))}, leftover(), true, nil
            default:
                // UNSPEC / UDP / unix: keep the peer address.
                return nil, nil, leftover(), true, nil
            }
        }
        return nil, nil, leftover(), false, nil
    }

    // lamSftpReplayConn hands bytes already read (the client's version line)
    // back to the SSH handshake before reading from the connection.
    type lamSftpReplayConn struct {
        net.Conn
        prefix []byte
    }

    func (c *lamSftpReplayConn) Read(p []byte) (int, error) {
        if len(c.prefix) > 0 {
            n := copy(p, c.prefix)
            c.prefix = c.prefix[n:]
            return n, nil
        }
        return c.Conn.Read(p)
    }

    // lamSftpPeekClientVersion reads the client's identification line
    // ("SSH-2.0-OpenSSH_9.6\r\n", RFC 4253 4.2: at most 255 bytes) within
    // wait. It returns the version ("" when absent) and every byte read.
    func lamSftpPeekClientVersion(conn net.Conn, wait time.Duration) (string, []byte) {
        // Bypass the idle-timeout wrapper, whose reads re-arm their own deadline.
        if deadlineConn, ok := conn.(*lamSftpDeadlineConn); ok {
            conn = deadlineConn.Conn
        }
        _ = conn.SetReadDeadline(time.Now().Add(wait))
        defer conn.SetReadDeadline(time.Time{})
        buf := make([]byte, 0, 256)
        one := make([]byte, 1)
        for len(buf) < 255 {
            n, err := conn.Read(one)
            if n == 1 {
                buf = append(buf, one[0])
                if one[0] == '\n' {
                    break
                }
            }
            if err != nil {
                break
            }
        }
        line := strings.TrimRight(string(buf), "\r\n")
        if !strings.HasPrefix(line, "SSH-") {
            return "", buf
        }
        return line, buf
    }

    func lamSftpVersionAtLeast(text string, want ...int) bool {
        parts := strings.FieldsFunc(text, func(r rune) bool { return r == '.' || r == '_' || r == 'p' || r == ' ' || r == '-' })
        for i, w := range want {
            if i >= len(parts) {
                return false
            }
            n, err := strconv.Atoi(parts[i])
            if err != nil {
                return false
            }
            if n != w {
                return n > w
            }
        }
        return true
    }

    // lamSftpGcmCapable reports whether a client version line belongs to an
    // implementation known to support aes*-gcm@openssh.com.
    func lamSftpGcmCapable(version string) bool {
        software := version
        if i := strings.Index(version, "-"); i >= 0 {
            if j := strings.Index(version[i+1:], "-"); j >= 0 {
                software = version[i+1+j+1:]
            }
        }
        fields := strings.Fields(software)
        if len(fields) == 0 {
            return false
        }
        software = fields[0]
        rules := []struct {
            prefix string
            min    []int
        }{
            {"OpenSSH_", []int{6, 2}},
            {"libssh2_", []int{1, 11}},
            {"libssh_", []int{0, 9}},
            {"paramiko_", []int{3, 5}},
            {"PuTTY_Release_", []int{0, 76}},
            {"Go", nil},
        }
        for _, rule := range rules {
            if !strings.HasPrefix(software, rule.prefix) {
                continue
            }
            if rule.min == nil {
                return software == "Go"
            }
            return lamSftpVersionAtLeast(strings.TrimPrefix(software, rule.prefix), rule.min...)
        }
        return false
    }

    func lamSftpServeConnection(raw net.Conn, server *SftpServer, runtime *lamSftpRuntime, sshConfig *ssh.ServerConfig) {
        defer func() { _ = recover() }()
        defer runtime.remove(raw)
        defer raw.Close()
        if deadlineConn, ok := raw.(*lamSftpDeadlineConn); ok {
            _ = deadlineConn.Conn.SetDeadline(time.Now().Add(time.Duration(server.Config.HandshakeTimeoutMs) * time.Millisecond))
        } else {
            _ = raw.SetDeadline(time.Now().Add(time.Duration(server.Config.HandshakeTimeoutMs) * time.Millisecond))
        }
        var base net.Conn = raw
        // PROXY protocol: the client address from a trusted load balancer.
        if mode := server.Config.ProxyProtocol; mode != "" && mode != "off" {
            trusted, _ := lamSftpParseCidrs(server.Config.ProxyTrusted)
            if lamSftpPeerTrusted(raw.RemoteAddr(), trusted) {
                remote, local, rest, present, err := lamSftpReadProxyHeader(raw)
                if err != nil || (!present && mode == "required") {
                    server.Metrics.ConnectionsRejected.Increment()
                    return
                }
                base = &lamSftpProxyConn{Conn: raw, remote: remote, local: local, prefix: rest}
            } else if mode == "required" {
                server.Metrics.ConnectionsRejected.Increment()
                return
            }
        }
        // Adaptive ciphers: choose the offer from the client's version line
        // (read here and replayed to the handshake).
        var handshakeConn net.Conn = base
        fallback := false
        if runtime.fallbackConfig != nil {
            version, replay := lamSftpPeekClientVersion(base, time.Second)
            handshakeConn = &lamSftpReplayConn{Conn: base, prefix: replay}
            if !lamSftpGcmCapable(version) {
                sshConfig = runtime.fallbackConfig
                fallback = true
            }
        }
        // Dedicated endpoints: host keys chosen by the destination address.
        announced := runtime.hostSigners
        if signers := runtime.signersFor(base.LocalAddr().String()); len(signers) > 0 {
            chosen := runtime.template
            if fallback {
                chosen.Config.Ciphers = append([]string(nil), runtime.fallbackCiphers...)
            }
            for _, signer := range signers {
                chosen.AddHostKey(signer)
            }
            sshConfig = &chosen
            announced = signers
        }
        connection, channels, requests, err := ssh.NewServerConn(handshakeConn, sshConfig)
        if err != nil {
            return
        }
        if deadlineConn, ok := raw.(*lamSftpDeadlineConn); ok {
            deadlineConn.setTimeout(runtime.idleTimeout)
        } else {
            _ = raw.SetDeadline(time.Time{})
        }
        defer connection.Close()
        runtime.track(raw, connection)
        lamSftpAnnounceHostKeys(connection, announced)
        go lamSftpGlobalRequests(connection, requests, announced)
        lamSftpServeChannels(connection, channels, server)
    }
}

func sftpAdapterLoaded() -> bool {
    return true
}
